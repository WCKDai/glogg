# glogg settings. Everything is optional; uncomment what you need.
# Docker Compose reads this file as .env; when running from source, export the variables instead.

# ── Docker Compose ──────────────────────────────────────────────────────
# Require a password (strongly recommended before glogg is reachable from other devices).
# GLOGG_PASSWORD=
# Port on this machine (docker-compose.yml publishes it on 127.0.0.1 only).
# GLOGG_PORT=4173
# Host names (or URLs) glogg may be reached under, besides localhost and IP addresses.
# GLOGG_ALLOWED_HOSTS=glogg.example.com

# ── Security ────────────────────────────────────────────────────────────
# Read the password from a file instead (a Docker secret, for example).
# GLOGG_PASSWORD_FILE=/run/secrets/glogg_password
# Other origins allowed to call the API (an extension of your own: chrome-extension://<id>).
# GLOGG_ALLOWED_ORIGINS=https://glogg.example.com
# Proxies whose X-Forwarded-For/-Proto glogg believes (default: one on this machine; the Docker setups set uniquelocal).
# GLOGG_TRUST_PROXY=1
# Let the reader, research and the deep index fetch private and local addresses (off: public pages only).
# GLOGG_ALLOW_PRIVATE_FETCH=1
# Listen address and port when running from source (default: this machine only).
# HOST=0.0.0.0
# PORT=4173

# ── Data ────────────────────────────────────────────────────────────────
# GLOGG_HOME=~/.glogg
# GLOGG_DOWNLOADS_DIR=~/Downloads/glogg

# ── Search backends (set in Settings → Integrations, or here) ───────────
# Docker Compose already points glogg at its own SearXNG (--profile searxng).
# SEARXNG_URL=http://localhost:8080
# BITMAGNET_URL=http://localhost:3333
# IPFS_GATEWAY_URL=http://localhost:8081
# TORZNAB_URL=http://localhost:9696
# TORZNAB_API_KEY=
# NEWZNAB_URL=http://localhost:5076
# NEWZNAB_API_KEY=
# Personal Marginalia key (the shared "public" key is rate-limited).
# MARGINALIA_API_KEY=
# Stack Exchange app key: 10,000 requests a day instead of 300 per address (stackapps.com).
# STACKEXCHANGE_KEY=
# Brave Search API key (api-dashboard.search.brave.com): Brave's web results through its API,
# since its search page mostly answers a server with a captcha. Paid per request.
# BRAVE_API_KEY=

# ── Containers ──────────────────────────────────────────────────────────
# auto (default), docker, podman, or none (never run either; the Docker image sets none).
# GLOGG_CONTAINER_RUNTIME=auto

# ── Network and speed (milliseconds) ────────────────────────────────────
# GLOGG_HAPPY_EYEBALLS=1
# GLOGG_CORE_GRACE_MS=500
# GLOGG_MIN_WAIT_MS=1000
# GLOGG_SOURCE_DEADLINE_MS=2000
# GLOGG_HARD_DEADLINE_MS=7000
# GLOGG_ANSWER_BUDGET_MS=2200
