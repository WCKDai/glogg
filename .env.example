# Single-instance SearXNG base URL (optional — glogg auto-connects when running via docker compose)
SEARXNG_URL=http://localhost:8080

# Self-hosted Bitmagnet GraphQL endpoint (optional — glogg falls back to public DHT & Archive BT)
BITMAGNET_URL=http://localhost:3333

# Local Kubo IPFS HTTP Gateway (optional — glogg falls back to ipfs.io / dweb.link)
IPFS_GATEWAY_URL=http://localhost:8081

# Custom Torznab / Prowlarr endpoint & API key (optional)
TORZNAB_URL=http://localhost:9696
TORZNAB_API_KEY=

# Custom Newznab / NZBHydra2 Usenet endpoint & API key (optional)
NEWZNAB_URL=http://localhost:5076
NEWZNAB_API_KEY=

# glogg web & API server port
PORT=4173

# Personal Marginalia key (the shared "public" key is rate-limited)
MARGINALIA_API_KEY=

# Stack Exchange app key: 10,000 requests a day instead of 300 per IP (stackapps.com)
STACKEXCHANGE_KEY=

# Set to 1 to use Node's default "happy eyeballs" connections instead of IPv4-first
GLOGG_HAPPY_EYEBALLS=

# Serve glogg under another host name or call it from another origin.
# Everything except search/OpenSearch/health is refused for other sites.
GLOGG_ALLOWED_HOSTS=
GLOGG_ALLOWED_ORIGINS=

# Search timing (milliseconds). See README → Speed.
GLOGG_CORE_GRACE_MS=500
GLOGG_MIN_WAIT_MS=1000
GLOGG_SOURCE_DEADLINE_MS=2000
GLOGG_HARD_DEADLINE_MS=7000
GLOGG_ANSWER_BUDGET_MS=2200
GLOGG_CACHE_TTL_MS=600000
GLOGG_SOURCE_REST_MS=300000
GLOGG_TOOL_TIMEOUT_MS=45000
